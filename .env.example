# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sombra_guardian

# ─── TON Provider ─────────────────────────────────────────────────────────────
TONAPI_BASE_URL=https://tonapi.io
TONAPI_API_KEY=your_tonapi_key_from_tonconsole

# ─── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=UTC

# Comma-separated Telegram numeric user IDs granted admin access
ADMIN_USER_IDS=123456789,987654321

# Timeouts and limits
HTTP_TIMEOUT_SECONDS=30
MAX_WATCHLIST_PER_USER=20

# Background worker polling interval in seconds
MONITOR_POLL_INTERVAL_SECONDS=60

# Max concurrent addresses processed by the worker
MONITOR_MAX_CONCURRENCY=5